<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

    <!-- O nome da persistence-unit e o mesmo usado em JPAUtil: Persistence.createEntityManagerFactory("loja") -->
    <persistence-unit name="loja" transaction-type="RESOURCE_LOCAL">

        <!-- Provedor JPA: Hibernate (obrigatorio nos trabalhos) -->
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Com "false", nao precisamos listar cada @Entity manualmente aqui -->
        <exclude-unlisted-classes>false</exclude-unlisted-classes>

        <properties>
           
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:mem:loja;DB_CLOSE_DELAY=-1"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>

            <!-- Hibernate cria/atualiza as tabelas automaticamente a partir das entidades -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>

            <!-- Mostra no console o SQL gerado (bom para estudar o que o JPA faz por baixo) -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>

    </persistence-unit>
</persistence>
